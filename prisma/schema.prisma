// =============================================================================
//  Cakestry AI Assistant — Prisma schema
//  Official database schema for Cakestry Bakery Bahawal Nagar
//
//  Serves two divisions:
//    • Cakestry Bakery & Custom Cakes — orders, products, customers, quotes
//    • Cakestry Special Events — event bookings, clients, packages
//
//  Shared infrastructure (users, RBAC, conversations, tickets, notifications,
//  settings, logs) carries a `department` column wherever a record belongs to
//  exactly one business, so every query can be scoped and the two pipelines
//  never bleed into each other.
//
//  Table names are mapped to the snake_case collection names in the brief.
//  Run `prisma migrate dev` to create the tables.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (PgBouncer) — used by the running application, which
  // opens and closes many short-lived connections.
  url      = env("DATABASE_URL")
  // Direct, unpooled connection — required for migrations, which need session
  // state that a transaction-mode pooler does not preserve. Falls back to
  // DATABASE_URL when unset, so a plain non-pooled setup still works.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------- Enums -----

/// The two businesses the assistant routes between.
enum Department {
  MARKETING
  INSTITUTE
}

enum Language {
  EN
  UR
  UR_ROMAN
  PA
}

/// Where a conversation is physically taking place. The assistant, the routing
/// and both knowledge bases are identical across channels — only the transport
/// and the way structured data is collected differ (the web chat opens a form,
/// WhatsApp asks one question at a time).
enum Channel {
  WEB
  WHATSAPP
}

/// Coarse access tier. Fine-grained rights live in Role/Permission.
enum UserRole {
  GUEST
  CUSTOMER
  STUDENT
  AGENT
  INSTRUCTOR
  ADMIN
  SUPER_ADMIN
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum LeadSource {
  CHATBOT
  WHATSAPP
  WEBSITE
  REFERRAL
  WALK_IN
  SOCIAL
  PHONE
  OTHER
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Cakestry Bakery order pipeline.
enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

/// Cakestry Special Events inquiry pipeline.
enum AdmissionStage {
  INQUIRY
  CONTACTED
  COUNSELLED
  APPLIED
  FEE_PENDING
  ENROLLED
  DROPPED
  LOST
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketCategory {
  TECHNICAL
  BILLING
  SALES
  COMPLAINT
  GENERAL
}

enum MeetingMode {
  OFFICE
  ZOOM
  GOOGLE_MEET
  WHATSAPP
}

enum MeetingStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ProjectStatus {
  DISCOVERY
  IN_PROGRESS
  REVIEW
  DELIVERED
  ON_HOLD
  CANCELLED
}

enum BatchStatus {
  PLANNED
  ENROLLING
  RUNNING
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
  SUSPENDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

enum KnowledgeKind {
  FAQ
  ARTICLE
  SERVICE
  COURSE
  POLICY
  DOCUMENT
}

enum PublishState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaKind {
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
  OTHER
}

enum ActivityType {
  NOTE
  FOLLOW_UP
  REMINDER
  CALL
  EMAIL
  WHATSAPP
  MEETING
  STAGE_CHANGE
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

// -------------------------------------------------- Identity & access --------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String?   @unique
  phone        String?   @unique
  cnic         String?   @unique
  passwordHash String?
  role         UserRole  @default(GUEST)
  /// Which business this staff member works for. Null = both (super admin).
  department   Department?
  language     Language  @default(EN)
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roleId String?
  rbac   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  conversations     Conversation[]
  assignedLeads     MarketingLead[]  @relation("LeadOwner")
  assignedAdmission Admission[]      @relation("AdmissionOwner")
  assignedTickets   Ticket[]         @relation("TicketAssignee")
  reportedTickets   Ticket[]         @relation("TicketReporter")
  hostedMeetings    Meeting[]        @relation("MeetingHost")
  activities        CrmActivity[]    @relation("ActivityOwner")
  notifications     Notification[]
  systemLogs        SystemLog[]
  customer          Customer?
  student           Student?
  faculty           Faculty?

  @@index([role])
  @@index([department])
  @@map("users")
}

/// Named role in the RBAC matrix, e.g. "Admissions Officer".
model Role {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  /// Restricts the role to one business; null = applies to both.
  department  Department?
  /// System roles cannot be deleted from the admin console.
  isSystem    Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

/// A single capability, e.g. `crm.leads.update`.
model Permission {
  id          String  @id @default(cuid())
  key         String  @unique
  group       String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ------------------------------------------------------------ Conversations --

model Conversation {
  id        String      @id @default(cuid())
  reference String      @unique
  /// Which surface this thread arrived on — the web widget or WhatsApp.
  channel   Channel     @default(WEB)
  /// Null until the visitor picks a business; set on the first routed turn.
  department Department?
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  title     String?
  language  Language    @default(EN)
  summary   String?
  /// WhatsApp sender (E.164 without `+`, as Meta reports it). Null on the web.
  contactPhone String?
  /// WhatsApp profile name, so the console shows a person rather than a number.
  contactName  String?
  /// In-progress slot filling for channels that have no forms. Shape:
  /// `{ flow, step, answers, startedAt }` — see `lib/whatsapp/capture.ts`.
  capture   Json?
  /// Set when a human takes over from the assistant.
  handedOff Boolean     @default(false)
  /// 1–5 rating captured by the chat satisfaction widget.
  rating    Int?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  messages   Message[]
  tickets    Ticket[]
  leads      MarketingLead[]
  admissions Admission[]
  meetings   Meeting[]

  @@index([userId])
  @@index([department])
  @@index([createdAt])
  @@index([channel, contactPhone, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ChatRole
  content        String
  department     Department?
  language       Language?
  tokens         Int?
  latencyMs      Int?
  /// Provider message id (WhatsApp `wamid.…`). Unique, which is what makes
  /// webhook redelivery idempotent: Meta retries until it sees a 200, and a
  /// retry then fails the insert instead of answering the customer twice.
  externalId     String?      @unique
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

// ================================================================ MARKETING ==

model MarketingLead {
  id           String     @id @default(cuid())
  reference    String     @unique
  name         String
  company      String?
  phone        String
  email        String?
  businessType String?
  /// Slug of the requested service (see marketing_services).
  serviceSlug  String?
  budget       String?
  timeline     String?
  requirements String
  source       LeadSource @default(CHATBOT)
  stage        LeadStage  @default(NEW)
  priority     Priority   @default(NORMAL)
  estimatedValue Decimal? @db.Decimal(12, 2)
  lostReason   String?
  ownerId      String?
  owner        User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  quotes   Quote[]
  meetings Meeting[]

  @@index([stage])
  @@index([createdAt])
  @@index([ownerId])
  @@map("marketing_leads")
}

model MarketingService {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  group       String
  tagline     String
  overview    String
  benefits    String[]
  features    String[]
  process     String[]
  /// Placeholder pricing until the final rate card is published.
  priceFrom   String?
  priceModel  String?
  priceNote   String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  portfolio PortfolioItem[]
  projects  Project[]

  @@index([group])
  @@map("marketing_services")
}

model Customer {
  id         String   @id @default(cuid())
  reference  String   @unique
  name       String
  company    String?
  phone      String
  email      String?
  address    String?
  city       String?
  industry   String?
  notes      String?
  isActive   Boolean  @default(true)
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  leads    MarketingLead[]
  projects Project[]
  quotes   Quote[]

  @@index([name])
  @@map("customers")
}

model Project {
  id          String        @id @default(cuid())
  reference   String        @unique
  title       String
  summary     String?
  status      ProjectStatus @default(DISCOVERY)
  startDate   DateTime?
  dueDate     DateTime?
  deliveredAt DateTime?
  value       Decimal?      @db.Decimal(12, 2)
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  serviceId   String?
  service     MarketingService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@map("projects")
}

model Quote {
  id          String      @id @default(cuid())
  reference   String      @unique
  title       String
  status      QuoteStatus @default(DRAFT)
  currency    String      @default("PKR")
  subtotal    Decimal     @default(0) @db.Decimal(12, 2)
  discount    Decimal     @default(0) @db.Decimal(12, 2)
  tax         Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @default(0) @db.Decimal(12, 2)
  /// Line items: [{ description, quantity, unitPrice }]
  items       Json?
  notes       String?
  validUntil  DateTime?
  sentAt      DateTime?
  decidedAt   DateTime?
  leadId      String?
  lead        MarketingLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@map("quotes")
}

model PortfolioItem {
  id          String     @id @default(cuid())
  slug        String     @unique
  department  Department @default(MARKETING)
  title       String
  client      String?
  summary     String
  outcome     String?
  imageUrl    String?
  link        String?
  tags        String[]
  serviceId   String?
  service     MarketingService? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  isPublished Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([department])
  @@map("portfolio_items")
}

model Review {
  id          String     @id @default(cuid())
  department  Department
  author      String
  role        String?
  company     String?
  rating      Int        @default(5)
  body        String
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now())

  @@index([department])
  @@map("reviews")
}

// ================================================================ INSTITUTE ==

model Course {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  group         String
  tagline       String
  overview      String
  curriculum    String[]
  duration      String
  /// Placeholder fee until the admissions office confirms the rate card.
  feeFrom       String?
  feeModel      String?
  feeNote       String?
  instalments   Json?
  careers       String[]
  projects      String[]
  certification String
  eligibility   String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  batches    Batch[]
  admissions Admission[]

  @@index([group])
  @@map("courses")
}

model Faculty {
  id         String   @id @default(cuid())
  reference  String   @unique
  name       String
  title      String
  bio        String?
  expertise  String[]
  photoUrl   String?
  email      String?
  phone      String?
  isActive   Boolean  @default(true)
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  courses Course[]
  batches Batch[]

  @@map("faculty")
}

model Batch {
  id         String      @id @default(cuid())
  code       String      @unique
  courseId   String
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  facultyId  String?
  faculty    Faculty?    @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  status     BatchStatus @default(PLANNED)
  startDate  DateTime
  endDate    DateTime?
  /// Human-readable timetable, e.g. "Mon/Wed/Fri · 6:00–8:00 PM".
  schedule   String
  mode       String      @default("On-campus")
  seats      Int         @default(25)
  seatsTaken Int         @default(0)
  room       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  enrollments Enrollment[]
  attendance  Attendance[]
  assignments Assignment[]
  admissions  Admission[]

  @@index([status])
  @@index([startDate])
  @@map("batches")
}

model Admission {
  id             String         @id @default(cuid())
  reference      String         @unique
  studentName    String
  fatherName     String?
  phone          String
  whatsapp       String?
  email          String?
  qualification  String?
  city           String?
  courseId       String?
  course         Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  /// Free-text course name when the inquiry predates the catalogue entry.
  courseName     String?
  preferredBatch String?
  batchId        String?
  batch          Batch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)
  source         LeadSource     @default(CHATBOT)
  stage          AdmissionStage @default(INQUIRY)
  priority       Priority       @default(NORMAL)
  notes          String?
  lostReason     String?
  ownerId        String?
  owner          User?          @relation("AdmissionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  studentId      String?
  student        Student?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([stage])
  @@index([createdAt])
  @@index([ownerId])
  @@map("admissions")
}

model Student {
  id            String   @id @default(cuid())
  rollNumber    String   @unique
  name          String
  fatherName    String?
  phone         String
  whatsapp      String?
  email         String?
  cnic          String?
  city          String?
  qualification String?
  photoUrl      String?
  isActive      Boolean  @default(true)
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  admissions   Admission[]
  enrollments  Enrollment[]
  attendance   Attendance[]
  certificates Certificate[]
  submissions  Submission[]

  @@index([name])
  @@map("students")
}

model Enrollment {
  id         String           @id @default(cuid())
  reference  String           @unique
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batchId    String
  batch      Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ACTIVE)
  feeStatus  FeeStatus        @default(PENDING)
  feeTotal   Decimal?         @db.Decimal(10, 2)
  feePaid    Decimal          @default(0) @db.Decimal(10, 2)
  /// Instalment ledger: [{ label, dueDate, amount, paidAt }]
  feePlan    Json?
  grade      String?
  enrolledAt DateTime         @default(now())
  completedAt DateTime?
  updatedAt  DateTime         @updatedAt

  @@unique([studentId, batchId])
  @@index([status])
  @@map("enrollments")
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batchId   String
  batch     Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  remarks   String?
  createdAt DateTime         @default(now())

  @@unique([studentId, batchId, date])
  @@index([date])
  @@map("attendance")
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  brief       String
  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  dueDate     DateTime?
  maxScore    Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id           String   @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileUrl      String?
  notes        String?
  score        Int?
  feedback     String?
  submittedAt  DateTime @default(now())

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

model Certificate {
  id         String   @id @default(cuid())
  reference  String   @unique
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseName String
  batchCode  String?
  grade      String?
  issuedAt   DateTime @default(now())
  fileUrl    String?
  /// Public verification code printed on the certificate.
  verifyCode String   @unique

  @@index([studentId])
  @@map("certificates")
}

// ========================================================= KNOWLEDGE BASES ==
//  Two physically separate tables. Keeping them apart is what makes the
//  "never mix business information" rule structural rather than a convention:
//  a marketing query can only ever read `knowledge_base_marketing`.

model MarketingKnowledge {
  id          String        @id @default(cuid())
  slug        String        @unique
  kind        KnowledgeKind @default(FAQ)
  category    String
  question    String
  answer      String
  keywords    String[]
  language    Language      @default(EN)
  state       PublishState  @default(PUBLISHED)
  /// Bumped on every edit; the AI index is rebuilt from the latest version.
  version     Int           @default(1)
  indexedAt   DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category])
  @@index([state])
  @@map("knowledge_base_marketing")
}

model InstituteKnowledge {
  id          String        @id @default(cuid())
  slug        String        @unique
  kind        KnowledgeKind @default(FAQ)
  category    String
  question    String
  answer      String
  keywords    String[]
  language    Language      @default(EN)
  state       PublishState  @default(PUBLISHED)
  version     Int           @default(1)
  indexedAt   DateTime?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category])
  @@index([state])
  @@map("knowledge_base_institute")
}

/// Documents, downloads and images referenced by either knowledge base.
model MediaAsset {
  id          String     @id @default(cuid())
  department  Department
  kind        MediaKind  @default(DOCUMENT)
  title       String
  description String?
  url         String
  mimeType    String?
  sizeBytes   Int?
  /// Exposed on the public "Downloads" menu when true.
  isDownload  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([department])
  @@map("media_assets")
}

// ============================================================ SHARED OPS ====

model Ticket {
  id             String         @id @default(cuid())
  reference      String         @unique
  department     Department
  category       TicketCategory @default(GENERAL)
  status         TicketStatus   @default(OPEN)
  priority       Priority       @default(NORMAL)
  subject        String
  description    String
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  resolution     String?
  resolvedAt     DateTime?
  reporterId     String?
  reporter       User?          @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assigneeId     String?
  assignee       User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([department])
  @@map("tickets")
}

model Meeting {
  id             String        @id @default(cuid())
  reference      String        @unique
  department     Department
  name           String
  phone          String
  email          String?
  businessName   String?
  topic          String?
  mode           MeetingMode   @default(ZOOM)
  status         MeetingStatus @default(REQUESTED)
  preferredDate  DateTime      @db.Date
  preferredTime  String
  confirmedAt    DateTime?
  meetingLink    String?
  notes          String?
  hostId         String?
  host           User?         @relation("MeetingHost", fields: [hostId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           MarketingLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([preferredDate])
  @@map("meetings")
}

/// Polymorphic CRM timeline: notes, follow-ups, reminders and stage changes
/// against a lead, admission, customer, student, ticket or project.
model CrmActivity {
  id          String       @id @default(cuid())
  department  Department
  type        ActivityType @default(NOTE)
  /// "MarketingLead" | "Admission" | "Customer" | "Student" | "Ticket" | "Project"
  entityType  String
  entityId    String
  body        String
  dueAt       DateTime?
  completedAt DateTime?
  ownerId     String?
  owner       User?        @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([entityType, entityId])
  @@index([dueAt])
  @@map("crm_activities")
}

model Event {
  id          String     @id @default(cuid())
  slug        String     @unique
  department  Department
  title       String
  summary     String
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  registerUrl String?
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([department])
  @@index([startsAt])
  @@map("events")
}

model Announcement {
  id          String      @id @default(cuid())
  department  Department?
  title       String
  body        String
  isPublished Boolean     @default(true)
  publishedAt DateTime    @default(now())
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([isPublished])
  @@map("announcements")
}

/// A person who has messaged the WhatsApp business number.
///
/// Kept separate from `users` because a WhatsApp contact is not an account:
/// it is a phone number with a profile name, which may later become a lead, an
/// admission inquiry, both, or nothing at all.
model WhatsappContact {
  id             String      @id @default(cuid())
  /// Meta's `wa_id` — E.164 digits with no leading `+`, e.g. `923001234567`.
  waId           String      @unique
  /// Same number in display form (`+923001234567`), used in the CRM.
  phone          String
  /// Name from the sender's WhatsApp profile, when they have set one.
  profileName    String?
  /// Business this contact last spoke to, so returning messages skip the menu.
  department     Department?
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  /// True after the contact sends STOP. Blocks broadcasts, not replies.
  optedOut       Boolean     @default(false)
  /// Set by staff to make the assistant ignore a number entirely.
  isBlocked      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([department])
  @@index([lastInboundAt])
  @@map("whatsapp_contacts")
}

model WhatsappTemplate {
  id          String     @id @default(cuid())
  key         String     @unique
  department  Department
  name        String
  language    Language   @default(EN)
  body        String
  /// Placeholder names in order, e.g. ["name", "courseName"].
  variables   String[]
  isApproved  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  broadcasts Broadcast[]

  @@index([department])
  @@map("whatsapp_templates")
}

model Broadcast {
  id          String          @id @default(cuid())
  reference   String          @unique
  department  Department
  channel     NotificationChannel @default(WHATSAPP)
  status      BroadcastStatus @default(DRAFT)
  title       String
  body        String
  /// Saved audience filter, e.g. { stage: "QUALIFIED", courseSlug: "seo" }.
  audience    Json?
  templateId  String?
  template    WhatsappTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scheduledAt DateTime?
  sentAt      DateTime?
  recipients  Int             @default(0)
  delivered   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@map("broadcasts")
}

model Notification {
  id         String              @id @default(cuid())
  department Department?
  channel    NotificationChannel
  status     NotificationStatus  @default(QUEUED)
  to         String
  subject    String?
  body       String
  /// Deep link into the admin console, e.g. /admin/crm/leads/<id>.
  link       String?
  userId     String?
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  sentAt     DateTime?
  error      String?
  createdAt  DateTime            @default(now())

  @@index([status])
  @@index([department])
  @@map("notifications")
}

/// Key/value application settings edited from Admin → Settings.
model Setting {
  id          String      @id @default(cuid())
  key         String      @unique
  /// Null for global settings; set for per-business overrides.
  department  Department?
  group       String      @default("general")
  value       Json
  description String?
  /// Secrets are write-only in the admin UI (never returned to the client).
  isSecret    Boolean     @default(false)
  updatedAt   DateTime    @updatedAt

  @@index([group])
  @@map("settings")
}

model SystemLog {
  id         String      @id @default(cuid())
  level      LogLevel    @default(INFO)
  department Department?
  action     String
  entity     String?
  entityId   String?
  message    String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([level])
  @@map("system_logs")
}

/// Daily rollup powering the admin dashboard widgets and reports.
model AnalyticsDaily {
  id                String     @id @default(cuid())
  date              DateTime   @db.Date
  department        Department?
  conversations     Int        @default(0)
  messages          Int        @default(0)
  leads             Int        @default(0)
  admissions        Int        @default(0)
  meetings          Int        @default(0)
  tickets           Int        @default(0)
  revenue           Decimal    @default(0) @db.Decimal(12, 2)
  conversionRate    Float      @default(0)
  avgResponseMs     Int        @default(0)
  satisfactionScore Float      @default(0)
  createdAt         DateTime   @default(now())

  @@unique([date, department])
  @@index([date])
  @@map("analytics_daily")
}

/// Official Daily Sales & Order Summary Snapshot generated at 11:00 PM PKT
model DailySummary {
  id              String   @id @default(cuid())
  summaryId       String   @unique
  summaryType     String   @default("BUSINESS_DAY")
  businessDate    String
  periodStart     DateTime
  periodEnd       DateTime
  timezone        String   @default("Asia/Karachi")
  totalOrders     Int      @default(0)
  grossSales      Decimal  @default(0) @db.Decimal(12, 2)
  discountTotal   Decimal  @default(0) @db.Decimal(12, 2)
  netSales        Decimal  @default(0) @db.Decimal(12, 2)
  paidSales       Decimal  @default(0) @db.Decimal(12, 2)
  pendingSales    Decimal  @default(0) @db.Decimal(12, 2)
  cancelledOrders Int      @default(0)
  completedOrders Int      @default(0)
  deliveryOrders  Int      @default(0)
  pickupOrders    Int      @default(0)
  uniqueCustomers Int      @default(0)
  itemsSold       Int      @default(0)
  topProductsJson Json?
  orderDetails    Json?
  generatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([businessDate])
  @@index([summaryId])
  @@index([generatedAt])
  @@map("daily_summaries")
}
