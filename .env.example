# =============================================================================
#  Cakestry AI Assistant — Environment Configuration
# =============================================================================
#  Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# -----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NODE_ENV=development
APP_NAME="Cakestry AI Assistant"
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL / Supabase) ---------------------------------------
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
DIRECT_DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# --- Cache (Redis) ----------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Authentication ---------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# --- AI Provider ------------------------------------------------------------
AI_PROVIDER=openai
AI_MODEL=gpt-3.5-turbo
AI_MAX_TOKENS=1400
AI_THINKING=false

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (claude)
ANTHROPIC_API_KEY=

# Google Gemini (gemini)
GEMINI_API_KEY=

# --- Notifications ----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=order@cakestry.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM="Cakestry Bakery <order@cakestry.com>"

SMS_API_KEY=
SMS_SENDER_ID=CAKESTRY

# --- WhatsApp Business Cloud API (Meta) -------------------------------------
WHATSAPP_PHONE_ID=1298684596664607
WHATSAPP_TOKEN=EAAfyNsA1NGM...
WHATSAPP_VERIFY_TOKEN=my_bakery_secure_webhook_verify_token_2026
WHATSAPP_APP_SECRET=2eb766a8d28204b55c2ae69644e3e775
WHATSAPP_API_VERSION=v21.0
WHATSAPP_AUTO_REPLY=true

GOOGLE_MAPS_API_KEY=

# --- Team routing -----------------------------------------------------------
SALES_NOTIFY_EMAIL=order@cakestry.com
ADMISSIONS_NOTIFY_EMAIL=events@cakestry.com

# --- Seed accounts ----------------------------------------------------------
SEED_ADMIN_EMAIL=admin@cakestry.com
SEED_ADMIN_PASSWORD=Password123!
SEED_STAFF_PASSWORD=Password123!

# --- Branding ---------------------------------------------------------------
NEXT_PUBLIC_BRAND_NAME="Cakestry Bakery Bahawal Nagar"
NEXT_PUBLIC_BRAND_URL=https://cakestry.com
NEXT_PUBLIC_BRAND_TAGLINE="Crafting Sweet Moments & Custom Cakes in Bahawal Nagar"
